# Copy to .env (gitignored). Each dev uses their own key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# live = real Lyria RealTime; mock = paced test tone, no Google calls
MUSIC_MODE=live
# Relay bind address (127.0.0.1 local dev; 0.0.0.0 for deploys)
HOST=127.0.0.1
# Relay port (Vite dev server proxies /api/music here)
PORT=8787

# Optional, server-only text-to-music intent translation (Crusoe Nemotron Lightning).
# Never prefix this with VITE_ or include it in browser configuration.
CRUSOE_API_KEY=
