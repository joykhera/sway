# Copy to .env (gitignored). Each dev uses their own key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# live = real Lyria RealTime; mock = paced test tone, no Google calls
MUSIC_MODE=live
# Relay bind address (127.0.0.1 local dev; 0.0.0.0 for deploys)
HOST=127.0.0.1
# Relay port (Vite dev server proxies /api/music here)
PORT=8787

# --- Self-improvement track (tools/selfimprove): Crusoe Managed Inference + NVIDIA Nemotron ---
# Key from the Crusoe console. Server/script side only, never in the browser.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Confirm exact IDs with: pnpm selfimprove:smoke (it lists the live Nemotron models)
CRUSOE_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
CRUSOE_MODEL_STRONG=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
